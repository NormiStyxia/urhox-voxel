<?xml version="1.0" encoding="utf-8"?>
<!-- 家园锻造炉：炉膛火舌 + 炉口暖光 + 火星 + 烟囱烟。节点放在炭床中心，烟从烟囱口（节点上方 5.45m、后 0.45m）冒出。 -->
<ParticleSystem version="2" warmupTime="1.5" warmupTickRate="20" secondsBeforeInactive="0.5">
    <Emitter emitterName="Glow">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="5"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.8" max="1.2"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.5 0.1 -0.2" max="0.5 0.3 0.2"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="1.1 1.1 1.1" max="1.5 1.5 1.5"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="Constant" constant="1 0.32 0.08"/>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.4" outVal="0.35"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Flame">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="36"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.4" max="0.75"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.8 0 -0.35" max="0.8 0.05 0.35"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.12 0.6 -0.25" max="0.12 1.1 0.05"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.3 0.3 0.3" max="0.5 0.5 0.5"/>
            </Module>
            <Module type="SizeMultiplyLife">
                <LifeMultiplier type="ConstantCurve">
                    <Point inVal="0" outVal="0.7 0.7 0.7"/>
                    <Point inVal="0.3" outVal="1.1 1.1 1.1"/>
                    <Point inVal="1" outVal="0.35 0.35 0.35"/>
                </LifeMultiplier>
            </Module>
            <Module type="Rotation">
                <StartRotation type="Uniform" min="0" max="360"/>
            </Module>
            <Module type="RotationRate">
                <StartRotationRate type="Uniform" min="-90" max="90"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1 0.85 0.45"/>
                    <Point inVal="0.35" outVal="1 0.5 0.12"/>
                    <Point inVal="1" outVal="0.8 0.12 0.02"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.15" outVal="0.9"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
            <Module type="ColorScaleOverLife">
                <ColorScaleOverLife type="Constant" constant="2.2 2.2 2.2"/>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Sparks">
        <Required material="Effects/Forge/Spark.material" screenAlignment="Velocity" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Uniform" min="4" max="10"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.6" max="1.4"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.5 0.2 -0.3" max="0.5 0.4 0.2"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.5 1.0 -1.4" max="0.5 2.2 -0.5"/>
            </Module>
            <Module type="Acceleration">
                <Acceleration type="Uniform" min="-0.3 -2.5 -0.3" max="0.3 -1.5 0.3"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.025 0.025 0.025" max="0.05 0.05 0.05"/>
            </Module>
            <Module type="SizeScaleBySpeed" speedScale="1 3" maxScale="1 6"/>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1 0.9 0.55"/>
                    <Point inVal="1" outVal="1 0.3 0.05"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1"/>
                    <Point inVal="0.7" outVal="1"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
            <Module type="ColorScaleOverLife">
                <ColorScaleOverLife type="Constant" constant="4 4 4"/>
            </Module>
            <Module type="KillHeight" floor="true" absolute="false">
                <Height type="Constant" constant="-0.75"/>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Smoke">
        <Required material="Effects/Forge/Smoke.material" emitterOrigin="0 5.45 0.45" screenAlignment="Square"
                  emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="5"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="3" max="4.5"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.15 0 -0.15" max="0.15 0.1 0.15"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.1 0.7 -0.1" max="0.1 1.0 0.1"/>
            </Module>
            <Module type="Acceleration" alwaysInWorldSpace="true">
                <Acceleration type="Uniform" min="0.12 -0.08 0.04" max="0.25 -0.03 0.1"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.4 0.4 0.4" max="0.6 0.6 0.6"/>
            </Module>
            <Module type="SizeMultiplyLife">
                <LifeMultiplier type="ConstantCurve">
                    <Point inVal="0" outVal="0.6 0.6 0.6"/>
                    <Point inVal="1" outVal="3.2 3.2 3.2"/>
                </LifeMultiplier>
            </Module>
            <Module type="Rotation">
                <StartRotation type="Uniform" min="0" max="360"/>
            </Module>
            <Module type="RotationRate">
                <StartRotationRate type="Uniform" min="-20" max="20"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0.32 0.3 0.29"/>
                    <Point inVal="1" outVal="0.62 0.62 0.64"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.15" outVal="0.45"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
        </Modules>
    </Emitter>
</ParticleSystem>
