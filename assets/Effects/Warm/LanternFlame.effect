<?xml version="1.0" encoding="utf-8"?>
<!-- 灯笼 / 壁灯 / 火盆里的小火苗：灯芯尖火 + 弱光团。节点放在灯芯处，粒子随灯移动。 -->
<ParticleSystem version="2" warmupTime="0.6" warmupTickRate="20" secondsBeforeInactive="0.5">
    <Emitter emitterName="Halo">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" useLocalSpace="true"
                  emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="3"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.9" max="1.3"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="0 0.04 0" max="0 0.06 0"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.34 0.34 0.34" max="0.42 0.42 0.42"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="Constant" constant="1 0.42 0.12"/>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.5" outVal="0.18"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Flame">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" useLocalSpace="true"
                  emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="22"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.22" max="0.36"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.012 0 -0.012" max="0.012 0.01 0.012"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.02 0.22 -0.02" max="0.02 0.36 0.02"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.07 0.07 0.07" max="0.1 0.1 0.1"/>
            </Module>
            <Module type="SizeMultiplyLife">
                <LifeMultiplier type="ConstantCurve">
                    <Point inVal="0" outVal="0.9 0.9 0.9"/>
                    <Point inVal="0.35" outVal="1 1 1"/>
                    <Point inVal="1" outVal="0.3 0.3 0.3"/>
                </LifeMultiplier>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1 0.9 0.55"/>
                    <Point inVal="0.4" outVal="1 0.55 0.15"/>
                    <Point inVal="1" outVal="0.8 0.18 0.03"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.12" outVal="0.95"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
            <Module type="ColorScaleOverLife">
                <ColorScaleOverLife type="Constant" constant="2.2 2.2 2.2"/>
            </Module>
        </Modules>
    </Emitter>
</ParticleSystem>
