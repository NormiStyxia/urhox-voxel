<?xml version="1.0" encoding="utf-8"?>
<!-- 柱上火盆壁灯：比灯笼大、比篝火小的明火 + 少量火星。节点放在火盆口。 -->
<ParticleSystem version="2" warmupTime="0.8" warmupTickRate="20" secondsBeforeInactive="0.5">
    <Emitter emitterName="Glow">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="3"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.8" max="1.2"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.03 0.1 -0.03" max="0.03 0.16 0.03"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.55 0.55 0.55" max="0.7 0.7 0.7"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="Constant" constant="1 0.36 0.09"/>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.4" outVal="0.2"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Flame">
        <Required material="Effects/Forge/FireAdd.material" screenAlignment="Square" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Constant" constant="26"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.28" max="0.48"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.06 0 -0.06" max="0.06 0.03 0.06"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.05 0.45 -0.05" max="0.05 0.75 0.05"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.14 0.14 0.14" max="0.22 0.22 0.22"/>
            </Module>
            <Module type="SizeMultiplyLife">
                <LifeMultiplier type="ConstantCurve">
                    <Point inVal="0" outVal="0.8 0.8 0.8"/>
                    <Point inVal="0.3" outVal="1.1 1.1 1.1"/>
                    <Point inVal="1" outVal="0.25 0.25 0.25"/>
                </LifeMultiplier>
            </Module>
            <Module type="Rotation">
                <StartRotation type="Uniform" min="0" max="360"/>
            </Module>
            <Module type="RotationRate">
                <StartRotationRate type="Uniform" min="-90" max="90"/>
            </Module>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1 0.86 0.48"/>
                    <Point inVal="0.35" outVal="1 0.5 0.12"/>
                    <Point inVal="1" outVal="0.75 0.13 0.02"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="0"/>
                    <Point inVal="0.15" outVal="0.9"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
            <Module type="ColorScaleOverLife">
                <ColorScaleOverLife type="Constant" constant="2.0 2.0 2.0"/>
            </Module>
        </Modules>
    </Emitter>
    <Emitter emitterName="Sparks">
        <Required material="Effects/Forge/Spark.material" screenAlignment="Velocity" emitterDuration="1" emitterLoops="0"/>
        <Spawn>
            <Rate type="Uniform" min="1" max="3"/>
        </Spawn>
        <Modules>
            <Module type="Lifetime">
                <Lifetime type="Uniform" min="0.6" max="1.2"/>
            </Module>
            <Module type="Location">
                <StartLocation type="Uniform" min="-0.05 0.12 -0.05" max="0.05 0.2 0.05"/>
            </Module>
            <Module type="Velocity">
                <StartVelocity type="Uniform" min="-0.25 0.7 -0.25" max="0.25 1.3 0.25"/>
            </Module>
            <Module type="Acceleration">
                <Acceleration type="Uniform" min="-0.3 -0.5 -0.3" max="0.3 -0.2 0.3"/>
            </Module>
            <Module type="Size">
                <StartSize type="Uniform" min="0.015 0.015 0.015" max="0.03 0.03 0.03"/>
            </Module>
            <Module type="SizeScaleBySpeed" speedScale="1 2.5" maxScale="1 4"/>
            <Module type="ColorOverLife">
                <ColorOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1 0.85 0.5"/>
                    <Point inVal="1" outVal="1 0.3 0.05"/>
                </ColorOverLife>
                <AlphaOverLife type="ConstantCurve">
                    <Point inVal="0" outVal="1"/>
                    <Point inVal="0.6" outVal="1"/>
                    <Point inVal="1" outVal="0"/>
                </AlphaOverLife>
            </Module>
            <Module type="ColorScaleOverLife">
                <ColorScaleOverLife type="Constant" constant="3.5 3.5 3.5"/>
            </Module>
        </Modules>
    </Emitter>
</ParticleSystem>
